# PMOVES-Wealth (Firefly III) - PMOVES Branded Defaults
# Source: pmoves/env.shared in parent PMOVES.AI repo
# Dual-mode: standalone (fork) or docked (PMOVES.AI integration)

# =============================================================================
# IMAGE CONFIGURATION
# =============================================================================
# Docker image to use
FIREFLY_IMAGE=ghcr.io/powerfulmoves/pmoves-wealth:pmoves-latest

# Upstream Firefly III base image (for building)
FIREFLY_UPSTREAM_IMAGE=fireflyiii/core
FIREFLY_UPSTREAM_TAG=latest

# =============================================================================
# SERVICE CONFIGURATION
# =============================================================================
# Container name
CONTAINER_NAME=pmoves-wealth

# Database container name (when using PostgreSQL)
DB_CONTAINER_NAME=pmoves-wealth-db

# Network name for standalone mode
NETWORK_NAME=pmoves_app

# Parent data network (when docked to PMOVES.AI)
PARENT_DATA_NETWORK=pmoves_data

# Volume prefix for named volumes
VOLUME_PREFIX=firefly

# =============================================================================
# PORTS & URLS
# =============================================================================
# Web UI port
# - Standalone: 8080 (default, may conflict with Agent Zero if PMOVES.AI running)
# - Docked: Parent env.shared sets FIREFLY_PORT=8082 to avoid conflicts
# - Override if port is already in use on your host
FIREFLY_PORT=8080

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Database type: sqlite (default) or postgres
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/storage/database.sqlite

# PostgreSQL configuration (when using --profile postgres)
POSTGRES_DB=firefly
POSTGRES_USER=firefly
# IMPORTANT: Change this password in production!
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_SECURE_PASSWORD

# =============================================================================
# FIREFLY III CORE SETTINGS
# =============================================================================
# Environment: local, production, testing
APP_ENV=production
APP_DEBUG=false

# Site owner email
# PMOVES standard: pmoves@pmoves.ai for ALL services
SITE_OWNER=pmoves@pmoves.ai

# Application key (MUST be exactly 32 characters)
# Run 'make generate-key' to generate a secure key
APP_KEY=CHANGE_ME_RUN_MAKE_GENERATE_KEY

# Default language and locale
DEFAULT_LANGUAGE=en_US
DEFAULT_LOCALE=equal

# Timezone
TZ=UTC

# Trusted proxies (for reverse proxy)
TRUSTED_PROXIES=**

# Log channel: stack, daily, syslog, errorlog, stdout
LOG_CHANNEL=stack

# Log level: debug, info, notice, warning, error, critical, alert, emergency
LOG_LEVEL=info

# =============================================================================
# PMOVES INTEGRATION
# =============================================================================
# Mode: standalone or docked
# - standalone: Runs independently with local configuration
# - docked: Connects to PMOVES.AI infrastructure (requires parent network)
PMOVES_MODE=standalone

# =============================================================================
# PMOVES BRANDED DEFAULTS - Application Credentials
# =============================================================================
# Default admin credentials (first run only)
# PMOVES standard: pmoves@pmoves.ai for ALL services
# IMPORTANT: Change these after first login!
FIREFLY_ADMIN_EMAIL=pmoves@pmoves.ai
FIREFLY_ADMIN_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# =============================================================================
# NOTES
# =============================================================================
# - First run will create admin account
# - Run 'make generate-key' to generate a secure APP_KEY
# - For production, use PostgreSQL profile: make up-postgres
# - When docked to PMOVES.AI, set PMOVES_MODE=docked
# - Backup data regularly (upload and export volumes)
