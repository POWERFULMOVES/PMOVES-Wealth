# PMOVES-Wealth - Local Overrides (.env.local)
# This file contains sensitive/secret values and should NOT be committed
# Copy from .env.local.example and customize for your environment

# =============================================================================
# SECRETS - CHANGE THESE IN PRODUCTION!
# =============================================================================

# Application Key (MUST be exactly 32 characters)
# Run: openssl rand -base32 32 | cut -c1-32
APP_KEY=CHANGE_ME_GENERATE_SECURE_KEY

# PostgreSQL password (when using PostgreSQL profile)
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# Admin credentials for first run
FIREFLY_ADMIN_EMAIL=admin@pmoves.ai
FIREFLY_ADMIN_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# =============================================================================
# LOCAL OVERRIDES
# =============================================================================

# Override any values from .env here for local development
# Example:
# APP_DEBUG=true
# LOG_LEVEL=debug
